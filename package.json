{
  "name": "assignment-1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run backend:build",
    "build:workspace": "pnpm -r build",
    "dev": "pnpm run backend:dev",
    "clean": "pnpm -r clean",
    "backend:build": "cd apps/backend && pnpm build",
    "backend:dev": "cd apps/backend && pnpm dev",
    "start": "cd apps/backend && pnpm start",
    "prisma:generate": "cd apps/backend && pnpm exec prisma generate",
    "prisma:migrate": "cd apps/backend && pnpm exec prisma migrate deploy",
    "prisma:studio": "cd apps/backend && pnpm exec prisma studio"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "@supabase/supabase-js": "^2.111.0",
    "prisma": "^5.16.0",
    "stripe": "^22.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}